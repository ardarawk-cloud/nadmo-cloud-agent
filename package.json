{
  "name": "nadmo-cloud-agent",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "NADMO Cloud Agent — safe browser-worker foundation for NADMO Scout",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "scout": "node src/index.js",
    "discover": "node src/discover-cli.js",
    "discover:local": "node src/local-discover-cli.js",
    "qualify": "node src/qualify-cli.js",
    "campaign": "node src/campaign-cli.js",
    "verify": "node src/verify-cli.js",
    "leads": "node src/leads-cli.js",
    "hunt": "node src/hunt-cli.js",
    "notify": "node src/notify-discord.js",
    "cycle": "npm run hunt && npm run notify",
    "notify:status": "node src/notify-status.js",
    "notify:retry": "node src/notify-retry.js",
    "scheduler:install": "bash scripts/install-scheduler.sh",
    "scheduler:status": "bash scripts/scheduler-status.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "playwright": "^1.51.1"
  }
}
