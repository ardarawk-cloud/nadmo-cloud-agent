{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nadmo-scout-approval-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nadmo-scout-approval-gateway"
    }
  ]
}
